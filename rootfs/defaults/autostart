#!/bin/sh
# -----------------------------------------------------------------------------
# TrialYard autostart for linuxserver/baseimage-selkies
# -----------------------------------------------------------------------------
# ACHTUNG POSIX: openbox runs this with /bin/sh (dash) — no bashisms.
#
# TrialYard has no single app to launch: it is a general-purpose desktop. This
# only sets the desktop background/theme and pins XDG dirs to the persistent
# /config volume (so behaviour is identical across PUID/PGID and survives a
# container recreate), then leaves the session sitting at an empty dark
# desktop — right-click for Terminal / Firefox / Google Chrome (see
# /defaults/menu.xml).
#
# Refreshed on EVERY start by init-trialyard (copied from /defaults/autostart),
# so image updates to this file always take effect.
# -----------------------------------------------------------------------------

export XDG_CONFIG_HOME="/config/.config"
export XDG_DATA_HOME="/config/.local/share"
export XDG_CACHE_HOME="/config/.cache"
case ":${XDG_DATA_DIRS:-}:" in
    *":/usr/share:"*) : ;;
    *) export XDG_DATA_DIRS="${XDG_DATA_DIRS:+$XDG_DATA_DIRS:}/usr/local/share:/usr/share" ;;
esac

# GTK dark theme (Firefox/Chrome chrome + any future GTK app) + a Carbon-ish
# (#161616) desktop background, same approach jdownloader uses for its root
# window — the area outside any open window stays dark instead of grey/white.
export GTK_THEME="${GTK_THEME:-Adwaita:dark}"
export GDK_BACKEND="${GDK_BACKEND:-x11}"

# Background: the baked-in wallpaper (#161616 + a small "right-click for
# apps" hint, bottom-center) via feh, which scales/crops to whatever
# resolution the client connects at. A totally blank canvas with no taskbar
# and no auto-started app reads as "broken" to a first-time viewer who
# doesn't know openbox's right-click menu exists — this hint is the fix, and
# it stays out of the way of anything opened on top of it (unlike an
# auto-launched app, which would not). Falls back to a flat xsetroot fill if
# feh or the wallpaper asset is ever missing, so a stripped-down rebuild
# still gets a sane (if hint-less) background instead of an X error.
if command -v feh >/dev/null 2>&1 && [ -f /usr/local/share/trialyard-wallpaper.png ]; then
    feh --no-fehbg --bg-fill /usr/local/share/trialyard-wallpaper.png 2>/dev/null \
        || xsetroot -solid '#161616' 2>/dev/null || true
else
    xsetroot -solid '#161616' 2>/dev/null || true
fi

# Keyboard map: bind a complete keymap so Shift resolves for pasted text
# (same fix as krusader/jdownloader — the Selkies base starts Xvfb with no
# keymap at all otherwise). KEYBOARD_LAYOUT (default us) picks the layout.
if setxkbmap_out=$(setxkbmap -display "${DISPLAY:-:1}" -layout "${KEYBOARD_LAYOUT:-us}" 2>&1); then
    echo "[trialyard-autostart] keymap: layout=${KEYBOARD_LAYOUT:-us} bound OK" >&2
else
    echo "[trialyard-autostart] keymap: setxkbmap FAILED (layout=${KEYBOARD_LAYOUT:-us}): ${setxkbmap_out}" >&2
fi

echo "[trialyard-autostart] desktop session starting (GTK_THEME=${GTK_THEME}, GDK_BACKEND=${GDK_BACKEND})" >&2
echo "[trialyard-autostart] right-click the desktop for Terminal / Firefox / Google Chrome" >&2

# No exec here on purpose: openbox runs autostart entries in the background
# and continues its own session; this script simply returns.
