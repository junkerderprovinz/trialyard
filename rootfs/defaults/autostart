#!/bin/sh
# openbox runs this with /bin/sh (dash), so no bashisms.
#
# TrialYard launches no app. This sets the background and theme, pins the XDG
# dirs to the persistent /config volume for every PUID and PGID, and leaves an
# empty dark desktop whose right-click menu (/defaults/menu.xml) opens a
# terminal, Firefox or Chrome. init-trialyard copies it into /config on every
# start.

export XDG_CONFIG_HOME="/config/.config"
export XDG_DATA_HOME="/config/.local/share"
export XDG_CACHE_HOME="/config/.cache"
case ":${XDG_DATA_DIRS:-}:" in
    *":/usr/share:"*) : ;;
    *) export XDG_DATA_DIRS="${XDG_DATA_DIRS:+$XDG_DATA_DIRS:}/usr/local/share:/usr/share" ;;
esac

export GTK_THEME="${GTK_THEME:-Adwaita:dark}"
export GDK_BACKEND="${GDK_BACKEND:-x11}"

# The wallpaper carries a small "right-click for apps" hint, since an empty
# desktop with no taskbar looks broken to anyone who does not know openbox's
# menu. A flat xsetroot fill stands in when feh or the wallpaper is missing.
#
# --bg-max rather than --bg-fill: Selkies resizes the desktop to the browser
# window, so the ratio never matches the image, and --bg-fill then repeats the
# leftover and shows the hint twice. --bg-max fits the whole image and fills
# the rest with --image-bg in the same colour as the fallback.
xsetroot -solid '#161616' 2>/dev/null || true
if command -v feh >/dev/null 2>&1 && [ -f /usr/local/share/trialyard-wallpaper.png ]; then
    feh --no-fehbg --bg-max --image-bg '#161616' \
        /usr/local/share/trialyard-wallpaper.png 2>/dev/null || true
else
    xsetroot -solid '#161616' 2>/dev/null || true
fi

# The Selkies base starts Xvfb without a keymap, and Shift does not resolve for
# pasted text until one is bound.
if setxkbmap_out=$(setxkbmap -display "${DISPLAY:-:1}" -layout "${KEYBOARD_LAYOUT:-us}" 2>&1); then
    echo "[trialyard-autostart] keymap: layout=${KEYBOARD_LAYOUT:-us} bound OK" >&2
else
    echo "[trialyard-autostart] keymap: setxkbmap FAILED (layout=${KEYBOARD_LAYOUT:-us}): ${setxkbmap_out}" >&2
fi

echo "[trialyard-autostart] desktop session starting (GTK_THEME=${GTK_THEME}, GDK_BACKEND=${GDK_BACKEND})" >&2
echo "[trialyard-autostart] right-click the desktop for Terminal / Firefox / Google Chrome" >&2
