#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Runs after init-selkies-config, which seeds openbox's autostart and menu.xml
# from /defaults on first boot only. The autostart is copied again on every
# start so an image update reaches it; menu.xml stays first-boot-only so hand
# edits survive.
set -e

log() { echo "[init-trialyard] $*"; }

CONFIG_HOME="/config/.config"
mkdir -p "${CONFIG_HOME}/openbox" \
         "/config/.local/share" \
         "/config/.cache" \
         "/config/npm-global" \
         "/config/go"

cp -af /defaults/autostart "${CONFIG_HOME}/openbox/autostart"
chmod 0755 "${CONFIG_HOME}/openbox/autostart"
log "autostart synced from /defaults/autostart"

chown -R "${PUID:-99}:${PGID:-100}" \
    "${CONFIG_HOME}" "/config/.local" "/config/.cache" \
    "/config/npm-global" "/config/go" 2>/dev/null || true

# Without this a failed GPU passthrough (wrong --runtime, missing
# NVIDIA_VISIBLE_DEVICES) falls back to software rendering without a word.
if command -v nvidia-smi >/dev/null 2>&1; then
    if gpu_name=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null); then
        log "GPU detected: ${gpu_name}"
    else
        log "WARNING: nvidia-smi is present but failed to query the GPU; check --runtime=nvidia and NVIDIA_VISIBLE_DEVICES on this container"
    fi
else
    log "WARNING: nvidia-smi not found in PATH, GPU passthrough is not active for this container"
fi

log "init-trialyard done"
exit 0
