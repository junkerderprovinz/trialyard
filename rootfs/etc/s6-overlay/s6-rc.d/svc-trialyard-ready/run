#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Prints the "READY" banner to the container log once the WebUI serves, so the
# user can tell the desktop is reachable.
FLAG="/run/trialyard-ready.printed"

# /run is a tmpfs, so the banner prints once per container start.
if [[ -f "${FLAG}" ]]; then
    exec sleep infinity
fi

# Port 3000 is served whatever the user's HTTPS preference. Waits up to 5 minutes.
ready=0
for _ in $(seq 1 150); do
    if (exec 3<>/dev/tcp/127.0.0.1/3000) 2>/dev/null; then
        exec 3>&- 3<&-
        ready=1
        break
    fi
    sleep 2
done

gpu="no GPU"
if command -v nvidia-smi >/dev/null 2>&1; then
    name=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null || true)
    [[ -n "${name}" ]] && gpu="${name}"
fi

/usr/local/bin/print-banner.sh "TrialYard" "GPU test/dev sandbox · Selkies · ${gpu}" 2>/dev/null || true

GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

if [[ "${ready}" -eq 1 ]]; then
    echo -e "  ${GREEN}✓ TRIALYARD IS READY${NC} - Open the WebUI via HTTPS on port ${CUSTOM_HTTPS_PORT:-3001}"
    echo "    GPU: ${gpu}"
else
    echo -e "  ${RED}✗ TRIALYARD DID NOT BECOME READY${NC} - The WebUI never answered within 5 minutes, check the log above"
fi
echo ""

touch "${FLAG}"
# A longrun that exits would be restarted by s6 and print the banner again.
exec sleep infinity
