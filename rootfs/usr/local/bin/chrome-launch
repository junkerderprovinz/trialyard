#!/bin/sh
# Google Chrome inside an unprivileged container: Chrome's own SUID sandbox
# helper needs privileges this container does not (and should not) have.
# --no-sandbox is the standard, expected way to run Chrome in a container
# that is already the isolation boundary (same approach Selenium/Playwright
# container images use). --disable-dev-shm-usage is not needed here — the
# container is started with --shm-size=1gb, which is plenty for Chrome's tab
# compositing.
exec google-chrome-stable --no-sandbox "$@"
